{
  "cli": {
    "version": ">= 7.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "enableHermes": true
      },
      "env": {
        "EAS_BUILD_ANDROID_MINIFY": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "enableHermes": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
